# ---- Postgres ----
DB_HOST=postgres
DB_PORT=5432
DB_NAME=waypoint
DB_USER=waypoint
DB_PASSWORD=waypoint

# ---- Backend ----
SERVER_PORT=8080
JWT_SECRET=replace-this-with-a-long-random-string-before-deploying
JWT_EXPIRATION_MS=86400000
SEED_DATA_DIR=/app/data/general_data
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- ML Service ----
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
BACKEND_BASE_URL=http://backend:8080
PORT=8000

# Model ids for each provider. Providers retire model ids over time (Groq
# retired llama-3.3-70b-versatile after this file was first written) —
# if the assistant starts failing with a "model not found" error, check the
# provider's current model list and set the matching one here.
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct